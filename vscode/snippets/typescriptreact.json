{
	// Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"New Storybook": {
		"prefix": "nsb",
		"body": [
			"import type {Meta} from \"@storybook/react-vite\";",
			"",
			"import {$1} from \"./$2\";",
			"",
			"const meta: Meta<typeof $1> = {",
			"    component: $1,",
			"    tags: [\"!autodocs\"],",
			"};",
			"",
			"export default meta;",
			"type Story = SafeStoryObj<typeof $1>;",
			"",
			"export const Default: Story = {",
			"    args: {$3},",
			"    render: (args) => <$1 {...args} />,",
			"};"
		],
		"description": "Create a new Storybook file from scratch using the official API"
	},
	"Aphrodite StyleSheet": {
		"prefix": "ass",
		"body": [
			"import {StyleSheet} from \"aphrodite\";",
			"const styles = StyleSheet.create({",
			"    $1",
			"});",
			"",
		],
		"description": "Creates a new Aphrodite `styles` variable",
	},
	"New Jest Test": {
		"prefix": "njt",
		"body": [
			"import {describe,expect,it} from \"@jest/globals\"",
			"import {$1} from \"./$2\"",
			"",
			"describe(\"$1\", () => {",
			"\tit('is a test', () => {",
			"\t\texpect(true).toBeTrue();",
			"\t});",
			"});",
		],
		"description": "Creates a new Jest test file with the correct imports (DUPLICATED WITH TS)",
	},
	"Jest Describe": {
		"prefix": "jd",
		"body": [
			"describe(\"$1\", $2 () => {",
			"$3",
			"});"
		],
		"description": "Creates a Jest `describe` block"
	},
	"Jest It": {
		"prefix": "ji",
		"body": [
			"it(\"$1\", $2 () => {",
			"$3",
			"});"
		],
		"description": "Creates a Jest `it` block"
	},
}