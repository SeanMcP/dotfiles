{
  "workbench.startupEditor": "none",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "git.confirmSync": false,
  "git.autofetch": true,
  "copyGithubUrl.defaultBranchFallback": "master",
  "editor.rulers": [
    80
  ],
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "vscode-graphql.rejectUnauthorized": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "githubPullRequests.pullBranch": "never",
  "editor.fontFamily": "\"Monaspace Neon\", \"Cascadia Code\", Menlo, Monaco, 'Courier New', monospace",
  "security.promptForLocalFileProtocolHandling": false,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.typegen.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    "*.mts": "${capture}.typegen.ts",
    "*.cts": "${capture}.typegen.ts"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "githubPullRequests.fileListLayout": "tree",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "git.checkoutType": [
    "local",
    "remote"
    // "tags", <-- included by default, excluded here.
  ],
  "github.copilot.editor.enableAutoCompletions": false,
  "go.toolsManagement.autoUpdate": true,
  "go.survey.prompt": false,
  "cSpell.userWords": [
    "khanacademy",
    "khanmigo",
    "seanmcp"
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.pasteAs.enabled": false,
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "notebook.formatOnSave.enabled": true,
  "workbench.settings.applyToAllProfiles": [],
  "docker.images.label": "RepositoryNameShort",
  "docker.containers.label": "ContainerName",
  "containers.containers.label": "ContainerName",
  "containers.images.label": "RepositoryNameShort",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.svg": "default"
  },
  "chat.modeFilesLocations": {
    "~/.github/chatmodes": false
  },
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "github.copilot.nextEditSuggestions.fixes": false,
  "github.copilot.renameSuggestions.triggerAutomatically": false,
  "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
  "chat.mcp.gallery.enabled": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.githubMcpServer.lockdown": true,
  "github.copilot.chat.githubMcpServer.readonly": true,
  "chat.tools.terminal.autoApprove": {
    "/^make gqlgen$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^go test \\./reading_assignment -v$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "opus",
  "claudeCode.useCtrlEnterToSend": true,
  "claudeCode.useTerminal": true,
  "task.allowAutomaticTasks": "on",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://khanacademy.org": {
      "approveRequest": true,
      "approveResponse": false
    }
  },
  "chat.viewSessions.orientation": "stacked",
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.colorTheme": "GitHub Dark Default",
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "terminal.integrated.initialHint": false,
  "spellright.notificationClass": "information",
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "spellright.ignoreFiles": [
    "**/.gitignore",
    "**/.spellignore"
  ],
  "spellright.documentTypes": [
    "go",
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "markdown",
    "latex",
    "plaintext"
  ],
}